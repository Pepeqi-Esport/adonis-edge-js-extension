import { HttpContext } from "@adonisjs/core/http";
import db from "@adonisjs/lucid/services/db";

import CheckHelper from "#helpers/check_helper";
import LogHelper from "#helpers/log_helper";
import MessageHelper from "#helpers/message_helper";
import PaginationHelper from "#helpers/pagination_helper";

import {{ name }} from "#models/{{ snakeName }}";

export default class {{ name }}Service {
  /**
   ** Index service
   *
   * @param ctx
   * @return object
   */
  public async index(ctx: HttpContext) {
    let {{ camelName }}Query = {{ name }}.query().orderBy(ctx.request.input("order_by"), ctx.request.input("order_type"));

    if (CheckHelper.isTrue(ctx.request.input("is_paginate"))) {
      let {{ camelName }} = await {{ camelName }}Query.paginate(ctx.request.input("page"), ctx.request.input("per_page"));

      let paginatedData = PaginationHelper.simplePaginate({{ camelName }});

      let data = paginatedData.data;
      let pagination = paginatedData.pagination;

      return {
        status: true,
        message: MessageHelper.retrieveSuccess(),
        data: data,
        pagination: pagination,
      };
    } else {
      let data = await {{ camelName }}Query;

      return {
        status: true,
        message: MessageHelper.retrieveSuccess(),
        data: data,
      };
    }
  }

  /**
   ** Detail service
   *
   * @param ctx
   * @return object
   */
  public async detail(ctx: HttpContext) {
    let data = await {{ name }}.findBy("id", ctx.request.input("{{ snakeName }}_id"));

    return {
      status: true,
      message: MessageHelper.retrieveSuccess(),
      data: data,
    };
  }

  /**
   ** Create service
   *
   * @param ctx
   * @return object
   */
  public async create(ctx: HttpContext) {
    let trx = await db.transaction();

    try {
      let {{ camelName }} = await {{ name }}.create({
        //
      });

      await trx.commit();

      let data = await {{ name }}.findBy("id", {{ camelName }}.id);

      return {
        status: true,
        message: MessageHelper.saveSuccess(),
        data: data,
      };
    } catch (error) {
      await trx.rollback();

      LogHelper.errorLog(ctx, error);

      return {
        status: false,
        message: MessageHelper.saveFail(),
      };
    }
  }

  /**
   ** Update service
   *
   * @param ctx
   * @return object
   */
  public async update(ctx: HttpContext) {
    let trx = await db.transaction();

    try {
      await {{ name }}.query()
        .where("id", ctx.request.input("{{ snakeName }}_id"))
        .update({
          //
        });

      await trx.commit();

      let data = await {{ name }}.findBy("id", ctx.request.input("{{ snakeName }}_id"));

      return {
        status: true,
        message: MessageHelper.saveSuccess(),
        data: data,
      };
    } catch (error) {
      await trx.rollback();

      LogHelper.errorLog(ctx, error);

      return {
        status: false,
        message: MessageHelper.saveFail(),
      };
    }
  }

  /**
   ** Delete service
   *
   * @param ctx
   * @return object
   */
  public async delete(ctx: HttpContext) {
    await {{ name }}.softDelete({{ name }}.query().where("id", ctx.request.input("{{ snakeName }}_id")));

    return {
      status: true,
      message: MessageHelper.deleteSuccess(),
    };
  }
}
