   * @return object
   */
  public async detail(ctx: HttpContext) {
    try {
      let schema = vine.object({
        {{ snakeName }}_id: vine.number().min(1).withoutDecimals().exists({
          table: "{{ tableName }}",
          column: "id",
          filter: (query) => {
            query.whereNull("deleted_at");
          },
        }),
      });

      let data = {
        {{ snakeName }}_id: ctx.request.input("{{ snakeName }}_id"),
