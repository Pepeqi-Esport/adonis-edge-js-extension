        "{{ snakeName }}_id.min": "ID {{ labelName }} harus minimal 1 !",
        "{{ snakeName }}_id.withoutDecimals": "ID {{ labelName }} harus berupa angka bulat !",
        "{{ snakeName }}_id.database.exists": "ID {{ labelName }} tidak ditemukan !",
      };

      await vine.validate({
        schema: schema,
        data: data,
        messagesProvider: new SimpleMessagesProvider(errorMessage),
      });

      return {
