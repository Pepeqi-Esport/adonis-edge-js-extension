import { HttpContext } from "@adonisjs/core/http";

import BaseController from "#controllers/base_controller";

import {{ name }}Service from "#services/{{ folderImport }}{{ snakeName }}_service";

import {{ name }}Validation from "#validations/{{ folderImport }}{{ snakeName }}_validation";

export default class {{ name }}Controller extends BaseController {
  /**
   ** Service instance
   *
   * @var {{ name }}Service
   */
  protected {{ camelName }}Service: {{ name }}Service;

  /**
   ** Validation instance
   *
   * @var {{ name }}Validation
   */
  protected {{ camelName }}Validation: {{ name }}Validation;

  /**
   ** Constructor
   *
   * @param {{ name }}Service {{ camelName }}Service
   * @param {{ name }}Validation {{ camelName }}Validation
   */
  constructor() {
    super();
    this.{{ camelName }}Service = new {{ name }}Service();
    this.{{ camelName }}Validation = new {{ name }}Validation();
  }

  /**
   ** Index
   *
   * @param ctx
   * @return response
   */
  public async index(ctx: HttpContext) {
    let validation = await this.{{ camelName }}Validation.index(ctx);

    if (!validation.status) {
      return this.formatResponse.sendResponse(ctx, validation);
    }

    let result = await this.{{ camelName }}Service.index(ctx);

    return this.formatResponse.sendResponse(ctx, result);
  }

  /**
   ** Detail
   *
   * @param ctx
   * @return response
   */
  public async detail(ctx: HttpContext) {
    let validation = await this.{{ camelName }}Validation.detail(ctx);

    if (!validation.status) {
      return this.formatResponse.sendResponse(ctx, validation);
    }

    let result = await this.{{ camelName }}Service.detail(ctx);

    return this.formatResponse.sendResponse(ctx, result);
  }

  /**
   ** Create
   *
   * @param ctx
   * @return response
   */
  public async create(ctx: HttpContext) {
    let validation = await this.{{ camelName }}Validation.create(ctx);

    if (!validation.status) {
      return this.formatResponse.sendResponse(ctx, validation);
    }

    let result = await this.{{ camelName }}Service.create(ctx);

    return this.formatResponse.sendResponse(ctx, result);
  }

  /**
   ** Update
   *
   * @param ctx
   * @return response
   */
  public async update(ctx: HttpContext) {
    let validation = await this.{{ camelName }}Validation.update(ctx);

    if (!validation.status) {
      return this.formatResponse.sendResponse(ctx, validation);
    }

    let result = await this.{{ camelName }}Service.update(ctx);

    return this.formatResponse.sendResponse(ctx, result);
  }

  /**
   ** Delete
   *
   * @param ctx
   * @return response
   */
  public async delete(ctx: HttpContext) {
    let validation = await this.{{ camelName }}Validation.delete(ctx);

    if (!validation.status) {
      return this.formatResponse.sendResponse(ctx, validation);
    }

    let result = await this.{{ camelName }}Service.delete(ctx);

    return this.formatResponse.sendResponse(ctx, result);
  }
}
