import { HttpContext } from "@adonisjs/core/http";
import vine, { SimpleMessagesProvider } from "@vinejs/vine";

import ErrorHelper from "#helpers/error_helper";
import HashHelper from "#helpers/hash_helper";
import MessageHelper from "#helpers/message_helper";

export default class {{ name }}Validation {
  /**
   ** Store validation
   *
   * @param ctx
   * @return object
   */
  public async store(ctx: HttpContext) {
    try {
      let schema = vine.object({
        //
      });

      let data = {
        //
      };

      let errorMessage = {
        //
      };

      await vine.validate({
        schema: schema,
        data: data,
        messagesProvider: new SimpleMessagesProvider(errorMessage),
      });

      return {
        status: true,
        statusNotify: "success",
        message: MessageHelper.validateSuccess(),
      };
    } catch (error) {
      let errorMessage = ErrorHelper.getFirstErrorMessage(ctx, error);

      return {
        status: false,
        statusNotify: "danger",
        message: errorMessage,
      };
    }
  }

